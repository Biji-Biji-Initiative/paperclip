POSTGRES_USER=paperclip
POSTGRES_PASSWORD=change-me-in-infisical
POSTGRES_DB=paperclip
DATABASE_URL=postgres://paperclip:change-me-in-infisical@db:5432/paperclip

PAPERCLIP_PUBLIC_URL=https://factory.mereka.io
PAPERCLIP_API_URL=https://factory.mereka.io
PAPERCLIP_ALLOWED_HOSTNAMES=factory.mereka.io,paperclip-factory.deploy.mereka.io
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false
PAPERCLIP_MIGRATION_AUTO_APPLY=true
PAPERCLIP_DB_BACKUP_ENABLED=true
PAPERCLIP_DB_BACKUP_RETENTION_DAYS=14
PAPERCLIP_SECRETS_STRICT_MODE=true
PAPERCLIP_SECRETS_MASTER_KEY=change-me-in-infisical
BETTER_AUTH_SECRET=change-me-in-infisical

# Prefer importing these from Infisical /shared/ai into /deploy/paperclip-factory.
# If these are blank, Paperclip local adapters can use mounted CLI subscription
# auth only when deploy/factory.caam-subscription.override.yaml is enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
